# Copy to .env and fill in. Never commit the real .env file.

# Where Station is listening (./station --web ... --tcp ...). Default: localhost.
STATION_HOST=localhost

# Bus serial for arm B, the one pulling against the PESOLA (from Station's web UI, on the bus card).
FOLLOWER_BUS_SERIAL=

# Bus serial for the leader arm, if used for teleoperation.
LEADER_BUS_SERIAL=

# Camera index/path used for session recording.
CAMERA_INDEX=0

# Optional, Linux only: some USB webcams reset manual exposure / white-balance-automatic to the
# device's power-on defaults every time a process opens them, not just on unplug/reboot (the ROG
# EYE S does this; the data_collection/camera_setup.sh cameras do not). If the live feed comes up
# dark or colour-cast each time you reopen the camera, set these from v4l2-ctl --list-ctrls and
# they get re-applied by lib/camera.py on every open. Leave unset (the default) for a camera that
# does not need it.
# CAMERA_V4L2_EXPOSURE=625
# CAMERA_V4L2_AUTO_WB=1

# Optional, Linux only: continuous autofocus and auto-ROI both re-adjust on their own as
# anything in frame moves - this is most of what reads as the camera "destabilising" the
# picture by itself. CAMERA_V4L2_FOCUS locks focus at a value (find it by setting
# `focus_automatic_continuous=1` via v4l2-ctl, letting it settle on the scale's working
# distance, then reading `focus_absolute` back); CAMERA_V4L2_ROI_AUTO=0 turns the auto-ROI
# bitmask off. Leave unset for a camera that does not do this.
# CAMERA_V4L2_FOCUS=240
# CAMERA_V4L2_ROI_AUTO=0

# Optional: the scale reader's red mask (gauge_reader/detector.py) accepts hue + Lab a* alone by
# default, which a hand can cross under some cameras/lighting even though skin is meant to stay
# below it. If the sticker tracker grabs a hand or other skin near the scale, set this to a
# saturation a hand never reaches but the stickers/marker do (detector.py's own numbers: stickers
# ~220, the marker ~200, skin ~130, wood ~75 - something like 150-180 is a reasonable start). A
# blob then needs at least one pixel this saturated to count, on top of the usual mask. Leave
# unset (0, off) unless you see this.
# GAUGE_SAT_STRONG=150

# Only needed if scripts/lerobot/ is ever used (SO-101 via LeRobot, not our hardware - see
# docs/elrobot.md): HF_TOKEN to push/pull datasets or models to the Hub, ROBOT_PORT / LEADER_PORT
# for the arm's serial ports.

# The dashboard has its own settings: see dashboard/.env.example
