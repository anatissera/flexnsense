# Copy to .env and fill in. Never commit the real .env file.

# Hugging Face token — only needed to push/pull datasets or models to the Hub.
HF_TOKEN=

# Serial port of the follower arm (from `lerobot-find-port`), e.g. /dev/ttyACM0
ROBOT_PORT=

# Serial port of the leader arm, if used for teleoperation.
LEADER_PORT=

# Camera index/path used for session recording.
CAMERA_INDEX=0

# --- Dashboard (Next.js app) ---
# OpenAI API key, used server-side only by app/api/chat and app/api/realtime
# (text chat and voice assistant). Required for the chat/voice panel.
OPENAI_API_KEY=

# Optional model overrides (defaults are set in the API routes).
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=
