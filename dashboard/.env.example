# Copy to dashboard/.env and fill in. Never commit the real .env file.

# --- Dashboard (Next.js app) ---
# The assistant's text side runs on either provider, server-side only (app/api/chat).
# Set GEMINI_API_KEY to use Gemini's OpenAI-compatible endpoint; it wins when both are present.
GEMINI_API_KEY=

# OpenAI API key, used server-side only by app/api/chat and app/api/realtime.
# The VOICE assistant (app/api/realtime) needs this one specifically: the browser speaks OpenAI's
# realtime protocol directly, which has no Gemini equivalent here. With only a Gemini key, the
# text assistant works and the voice button explains why it does not.
# The emergency stop by voice is unaffected: it is the browser's own speech recognition, no key.
OPENAI_API_KEY=

# Set to 1 for the public demonstration build: no hardware is probed, the force panel becomes a
# labelled simulation, and the page says throughout that nothing is attached. Leave it unset at
# the bench, where the two local servers are probed and reported instead.
# See docs/dashboard-demo.md.
NEXT_PUBLIC_DEMO=

# Optional model overrides (defaults are set in the API routes).
GEMINI_MODEL=
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=
