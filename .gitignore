# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/dashboard/node_modules
/dashboard/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/dashboard/coverage

# next.js
/dashboard/.next/
/dashboard/out/

# production
/dashboard/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# --- Python / gauge reader ---
__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store
node_modules/
*.log

# cloned third-party repos (not scripts/lerobot/, that's ours, kept on purpose - see docs/elrobot.md)
/WiLoR/
/lerobot/
/norma-core/

# Internal working docs (plans, datasheets) - not shared in the repo
internal-docs/

# Gauge reader: per-machine calibration and session output
config/scale_calib.json
recordings/

# Hand tracking: downloaded model, not committed
models/*.task

# Raw hand-tracking recordings: bulk per-session data, like recordings/. The fitted numbers
# they produce are committed (config/calibration/bench.json), the recordings themselves are not.
data/*.jsonl
