# Copy to .env (same folder) and fill in. .env is git-ignored: never commit it.
# Read by cloud/nebius/lib.sh; values here override cloud/nebius/workstation.<SITE>.env.

# --- Nebius account (required). Find them with:  nebius iam project list / nebius vpc network list / nebius vpc subnet list
# Region settings file to use: eu-south1 or us-central1
SITE=eu-south1
# project-...
PROJECT=
# vpcnetwork-...
NETWORK=
# vpcsubnet-...
SUBNET=

# --- Workstation (optional overrides). Defaults are in cloud/nebius/workstation.<SITE>.env.
# VM_NAME=flexnsense-ws
# DISK_NAME=flexnsense-ws-boot
# SG_NAME=flexnsense-ws-sg
# VM_USER=flex
# SSH_KEY=~/.ssh/id_ed25519

# --- NVIDIA Omniverse licence. Set to yes only after you have read and accepted the NVIDIA Omniverse License Agreement;
# setup_vm.sh then enables Isaac Sim (Kit) on the VM. Without it only the Newton (headless) environment is usable.
ACCEPT_OMNIVERSE_EULA=
